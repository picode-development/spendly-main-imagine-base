{
  "expo": {
    "name": "Spendly Widgets",
    "slug": "picode-development",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spendly.widgets"
    },
    "android": {
      "package": "com.spendly.widgets",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SpendlySummary",
              "label": "Spendly Summary",
              "description": "Today's spend, month total, and balance from Spendly",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "SpendlyActions",
              "label": "Spendly Quick Actions",
              "description": "Add a transaction by form, voice, or photo in one tap",
              "minWidth": "250dp",
              "minHeight": "70dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "SpendlyChart",
              "label": "Spendly Chart",
              "description": "Your last 7 days of spending at a glance",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "SpendlyTransactions",
              "label": "Spendly Transactions",
              "description": "Your latest transactions, scrollable",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "78f05329-5676-4306-becb-ce80c19d9f93"
      }
    },
    "owner": "picodedevelopments-team"
  }
}
